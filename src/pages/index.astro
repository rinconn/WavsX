---
import Base from '../layouts/Base.astro';
import '../styles/landing.css';
const keeps = [
  ['wav', 'Audio WAV', '24-bit · 48 kHz'],
  ['stems', 'Stems', '12 pistas'],
  ['portada', 'Portadas', '3000 × 3000'],
  ['letra', 'Letra', 'con sincronía'],
  ['creditos', 'Créditos', '60 / 40'],
  ['versiones', 'Versiones', 'v1 → v9'],
  ['enlace', 'Enlaces privados', 'solo escuchar'],
  ['lanzar', 'Lanzamiento', 'checklist y paquete']
];
---
<Base title="WavsX — Tu música, antes de salir" description="El estudio online para artistas: cada canción con sus WAV, stems, portadas, versiones y lanzamiento, en un solo sitio.">
<header class="nav">
  <a href="/" class="logo" data-logo aria-label="WavsX, inicio">wavsX</a>
  <nav aria-label="Principal" class="nav__links">
    <a href="#producto">Producto</a>
    <a href="#como">Cómo funciona</a>
    <a href="#empezar">Precios</a>
  </nav>
  <a href="/login" class="btn btn--neon nav__cta">Entrar</a>
  <span class="nav__progress" id="read" aria-hidden="true"></span>
</header>

<main>
  <!-- 1 · HERO -->
  <section class="hero">
    <canvas id="field" class="hero__canvas" aria-hidden="true"></canvas>
    <div class="hero__fade" aria-hidden="true"></div>
    <div class="hero__content">
      <h1 class="hero__title">
        <span class="line"><span>Tus canciones,</span></span>
        <span class="line"><span class="title-dim">antes de salir.</span></span>
      </h1>
      <p class="hero__sub" data-words>El estudio online para artistas. Cada tema con sus WAVs, stems, portadas y versiones, en un solo sitio.</p>
      <div class="hero__cta">
        <a href="/login" class="btn btn--neon btn--lg" data-air>Entrar en mi estudio</a>
        <a href="#como" class="btn btn--lg btn--ghost">Ver cómo funciona <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <a href="#producto" class="scroll-cue" aria-label="Bajar"><span></span></a>
  </section>

  <!-- 1 · HERO C (opción alternativa: /?hero=c) · cúpula de partículas -->
  <section class="heroC" hidden>
    <!-- pared de espuma acústica, desenfocada como en una foto con poca profundidad de campo -->
    <div class="foam" aria-hidden="true"></div>
    <i class="foam__light" aria-hidden="true"></i>
    <div class="heroC__content">
      <h1 class="hero__title">
        <span class="line"><span>Tus canciones,</span></span>
        <span class="line"><span class="title-dim">antes de salir.</span></span>
      </h1>
      <p class="hero__sub">Cada tema con sus WAVs, stems, portadas y versiones, en un solo sitio.</p>
      <div class="hero__cta">
        <a href="/login" class="btn btn--neon btn--lg" data-air>Entrar en mi estudio</a>
        <a href="#como" class="btn btn--lg btn--ghost">Ver cómo funciona <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <canvas id="dome" class="heroC__canvas" aria-hidden="true"></canvas>
    <canvas id="wavefield" class="heroC__canvas" aria-hidden="true"></canvas>
  </section>

  <!-- 1 · HERO B (opción alternativa: /?hero=b) -->
  <section class="heroB" hidden>
    <div class="heroB__glow" aria-hidden="true"></div>
    <div class="heroB__head">
      <h1 class="hero__title">
        <span class="line"><span>Tus canciones,</span></span>
        <span class="line"><span class="title-dim">antes de salir.</span></span>
      </h1>
      <p class="hero__sub">Cada tema con sus WAVs, stems, portadas y versiones, en un solo sitio.</p>
      <div class="hero__cta">
        <a href="/login" class="btn btn--neon btn--lg" data-air>Entrar en mi estudio</a>
        <a href="#como" class="btn btn--lg btn--ghost">Ver cómo funciona <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="heroB__win" aria-hidden="true">
      <div class="heroB__bar"><i></i><i></i><i></i><span>wavsx.app / neon-en-la-m-30</span></div>
      <div class="heroB__body">
        <div class="heroB__top">
          <div class="songcard__cover"></div>
          <div><b>Resiliencia</b><span class="songcard__status">Mezcla · v5 · 3:42</span></div>
          <span class="heroB__pill">Lista para salir</span>
        </div>
        <div class="vers"><span>v1</span><span>v2</span><span>v3</span><span>v4</span><span class="on">v5</span></div>
        <div class="bigwave">
          <span class="pin" style="left: 28%">0:48 · sube la voz</span>
          <div class="wave" id="heroB-wave" style="height: 88px"></div>
          <i class="heroB__head-line"></i>
        </div>
        <div class="heroB__stats">
          <div><small>Audio</small><b class="num">WAV 24-bit</b></div>
          <div><small>Stems</small><b class="num">12 pistas</b></div>
          <div><small>Créditos</small><b class="num">60 / 40</b></div>
          <div><small>Enlace privado</small><b class="num">3 escuchas</b></div>
        </div>
      </div>
    </div>
  </section>

  <div class="ledline" aria-hidden="true"><span></span></div>

  <!-- 2 · LO QUE GUARDA CADA CANCIÓN -->
  <section class="keeps" id="producto">
    <header class="keeps__head reveal">
      <span class="kicker">Lo que guarda cada canción</span>
      <h2>Seis cosas que siempre andan perdidas.<br><span class="muted">Ahora, juntas.</span></h2>
    </header>
    <div class="desk reveal" aria-label="Lo que guarda cada canción">
      <ol class="desk__tabs"><li><button type="button" class="desk__tab on" data-i="0"><span>01</span><b>Audio</b><small>Mezclas y master en WAV, sin comprimir.</small></button></li><li><button type="button" class="desk__tab" data-i="1"><span>02</span><b>Stems</b><small>Las pistas sueltas, listas para el ingeniero.</small></button></li><li><button type="button" class="desk__tab" data-i="2"><span>03</span><b>Portadas</b><small>La final, las alternativas y las fotos.</small></button></li><li><button type="button" class="desk__tab" data-i="3"><span>04</span><b>Letra</b><small>La buena, no la de las notas del móvil.</small></button></li><li><button type="button" class="desk__tab" data-i="4"><span>05</span><b>Créditos y reparto</b><small>Quién hizo qué y cuánto le toca a cada uno.</small></button></li><li><button type="button" class="desk__tab" data-i="5"><span>06</span><b>Versiones</b><small>De la demo del móvil al master, sin borrar nada.</small></button></li></ol>
      <div class="desk__view">
        <div class="pane on" data-i="0">
          <div class="pane__top"><b>resiliencia_master.wav</b><span class="badge">WAV · 24-bit · 48 kHz</span><span class="live"><i></i><time id="tc">0:48</time> / 5:04</span></div>
          <div class="specwrap"><ul class="axis"><li>20k</li><li>10k</li><li>5k</li><li>1k</li><li>100</li></ul><canvas class="spec" width="720" height="260" aria-label="Espectrograma del master"></canvas><div class="spec__info"><small>¿Qué es el WAV?</small><b>Tu canción, sin perder nada.</b><span>Audio sin comprimir, igual que sale del estudio. Aquí viven el master y cada mezcla, listos para la distribuidora.</span></div></div>
          <ul class="stats"><li><small>Pico real</small><b>-0,3 dBTP</b></li><li><small>Volumen</small><b>-9,4 LUFS</b></li><li><small>Rango</small><b>7,2 LU</b></li><li><small>Peso</small><b>87 MB</b></li><li><small>Versiones</small><b>master + 8 mezclas</b></li></ul>
        </div>
        <div class="pane" data-i="1">
          <div class="pane__top"><b>6 stems</b><span class="badge">WAV · 24-bit · 48 kHz</span><span class="live"><i></i>sincronizados</span></div>
          <div class="stemrow"><figure class="stemph"><img src="/covers/mesa.jpg" alt="Mesa de mezclas en una sala a oscuras" loading="lazy" /><figcaption><small>¿Qué son los stems?</small><b>Cada instrumento, por separado.</b><span>Tu mezcla partida en pistas: voz, bajo, batería… El ingeniero las abre en su programa y mezcla cada una a su gusto.</span></figcaption></figure><ul class="stl"><li class="st on"><button type="button" class="st__play" aria-label="Escuchar Voz lead"></button><div><b>Voz lead</b><small>voz_lead.wav</small></div><span>5:04</span><span>48 MB</span><i class="st__dl"></i><u class="st__bar"></u></li><li class="st"><button type="button" class="st__play" aria-label="Escuchar Coros"></button><div><b>Coros</b><small>coros.wav</small></div><span>5:04</span><span>52 MB</span><i class="st__dl"></i><u class="st__bar"></u></li><li class="st"><button type="button" class="st__play" aria-label="Escuchar Bajo"></button><div><b>Bajo</b><small>bajo.wav</small></div><span>5:04</span><span>48 MB</span><i class="st__dl"></i><u class="st__bar"></u></li><li class="st"><button type="button" class="st__play" aria-label="Escuchar Batería"></button><div><b>Batería</b><small>bateria.wav</small></div><span>5:04</span><span>96 MB</span><i class="st__dl"></i><u class="st__bar"></u></li><li class="st"><button type="button" class="st__play" aria-label="Escuchar Guitarras"></button><div><b>Guitarras</b><small>guitarras.wav</small></div><span>5:04</span><span>86 MB</span><i class="st__dl"></i><u class="st__bar"></u></li><li class="st"><button type="button" class="st__play" aria-label="Escuchar Sintes"></button><div><b>Sintes</b><small>sintes.wav</small></div><span>5:04</span><span>82 MB</span><i class="st__dl"></i><u class="st__bar"></u></li></ul></div>
          <ul class="stats"><li><small>Carpeta</small><b>resiliencia_stems.zip</b></li><li><small>Peso</small><b>412 MB</b></li><li><small>Para</small><b>Estudio Sur</b></li></ul>
        </div>
        <div class="pane" data-i="2"><div class="amb" aria-hidden="true"><div class="amb__m on" style="background-image:url(/covers/foto.jpg)"></div><div class="amb__m" style="background-image:url(/covers/animada.gif)"></div><video class="amb__m" src="/covers/video.mp4" muted loop playsinline preload="auto"></video></div>
          <div class="pane__top"><b>Portadas de «Resiliencia»</b><span class="badge">JPG · PNG · GIF · MP4</span></div>
          <div class="cov">
            <div class="cov__side"><small>¿Y las portadas?</small><h3>Pon la que quieras.</h3><p>Una imagen, un GIF o un vídeo corto. Lo pruebas dentro de la app y te quedas con el que mejor suene a tu canción.</p><div class="variants"><button type="button" class="v on" data-c="0"><i data-t="JPG" style="background-image:url(/covers/foto.jpg)"></i><span>Foto</span><em>JPG</em></button><button type="button" class="v" data-c="1"><i data-t="GIF" style="background-image:url(/covers/animada.gif)"></i><span>GIF</span><em>animado</em></button><button type="button" class="v" data-c="2"><i data-t="MP4" style="background-image:url(/covers/video.jpg)"></i><span>Vídeo</span><em>MP4 · 8 s</em></button></div><p class="cov__cap" id="cap"></p></div>
            <div class="win"><div class="win__bar"><i></i><span>wavsx.app/resiliencia</span></div>
              <div class="stage"><i class="halo" aria-hidden="true"></i><div class="sleeve"><div class="disc"><b></b></div><div class="app__cover" id="cv" data-k="0"><div class="m m0 on" style="background-image:url(/covers/foto.jpg)"></div><div class="m m1" style="background-image:url(/covers/animada.gif)"></div><video class="m m2" src="/covers/video.mp4" poster="/covers/video.jpg" muted loop playsinline preload="auto"></video><div class="vid"><i></i><u></u></div><em class="tag">Foto</em></div></div>
                <div class="phone" aria-hidden="true"><div class="phone__s"><video src="/covers/video-vertical.mp4" poster="/covers/video-vertical.jpg" muted loop playsinline preload="auto"></video><div class="phone__top"><i></i><span>9:16 · 8 s</span></div><div class="phone__b"><b>Resiliencia</b><span>Hostilidad</span><em><u></u></em></div></div></div>
                <div class="stage__t"><b>Resiliencia</b><span>Hostilidad · Single · 2026</span></div>
                <small class="fmts__t">Pruébalos y quédate con el que más te guste</small>
                <div class="fmts" role="group" aria-label="Formato de la portada"><button type="button" class="on" data-f="vinilo">Vinilo</button><button type="button" data-f="cd">CD</button><button type="button" data-f="casete">Casete</button></div>
              <div class="pl"><div class="pl__bar" id="plb" role="slider" tabindex="0" aria-label="Posición de la canción"><i></i><u></u></div><div class="pl__t"><span id="pt">1:12</span><span>5:04</span></div><div class="pl__ctl"><button type="button" class="pb" id="pprev" aria-label="Canción anterior"><svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><rect x="2" y="2" width="2" height="12"/><path d="M14 2.5v11L5.5 8z"/></svg></button><button type="button" class="pb" id="pback" aria-label="Atrás 15 segundos">−15</button><button type="button" class="pb play" id="pplay" aria-label="Pausa"></button><button type="button" class="pb" id="pfwd" aria-label="Adelante 15 segundos">+15</button><button type="button" class="pb" id="pnext" aria-label="Canción siguiente"><svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M2 2.5v11L10.5 8z"/><rect x="12" y="2" width="2" height="12"/></svg></button></div></div>
            </div></div>
          </div>
        </div>
        <div class="pane" data-i="3">
          <div class="pane__top"><b>letra_resiliencia.lrc</b><span class="badge">sincronizada · 8 frases</span></div>
          <div class="lhead">
            <div class="ltop__txt"><small>¿Y la letra?</small><h3>Cada frase, en su momento.</h3></div>
            <div class="lstyle" role="group" aria-label="Estilo de la letra"><button type="button" class="on" data-m="fill">Relleno</button><button type="button" data-m="words">Palabra a palabra</button><button type="button" data-m="type">Máquina de escribir</button></div>
          </div>
          <div class="lstage" id="lstage" data-m="fill">
            <div class="lstage__bg" aria-hidden="true" style="background-image:url(/covers/animada.gif)"></div><div class="lstage__top"><div class="lsong"><i style="background-image:url(/covers/animada.gif)"></i><div><b>Resiliencia</b><span>Hostilidad</span></div></div><div class="lstage__r"><span id="lsecn">Verso 1</span><span class="lt"><i class="bt" id="lbt"></i><time id="lct">0:12</time></span></div></div>
            <p class="lbig" id="lbig"></p>
            <div class="lnote" id="lnote"><i></i><div><b></b><span></span></div></div>
            <div class="lseg" id="lseg"></div>
          </div>
        </div>
        <div class="pane" data-i="4">
          <div class="pane__top"><b>reparto_resiliencia.pdf</b><span class="badge">acuerdo firmado · 12 mar</span></div>
          <div class="lhead">
            <div class="ltop__txt"><small>¿Y los créditos?</small><h3>Quién está detrás de la canción.</h3><p class="lhead__p">Y cada uno con su perfil: redes, estudio y contacto, a la vista de quien escuche la canción.</p></div>
            <button type="button" class="rbtn" id="rsign">Volver a firmar</button>
          </div>
          <div class="rcards signed"><article class="rc"><div class="rc__img" style="background-image:url(/covers/foto.jpg)"></div><span class="rc__role">Letra y música</span><div class="rc__bot"><b>Hostilidad</b><div class="rc__tags"><span>Voz</span><span>Letra</span><span>Guitarra</span></div><div class="rc__sig"><svg viewBox="0 0 160 56" aria-hidden="true"><path d="M6 38 C16 8 26 8 24 30 C22 48 34 14 46 22 C56 28 50 44 62 36 C74 28 82 14 92 30 C100 42 112 24 126 30 C136 34 144 32 154 24" pathLength="1"/></svg><small>Firmado 12 mar</small></div></div><div class="rc__back"><div class="rc__bh"><b>Hostilidad</b><span>Artista · Madrid</span></div><ul class="rc__list"><li><span class="ic" data-ic="ig" title="Instagram">Instagram</span><b>@hostilidad</b><small>12,4 k</small></li><li><span class="ic" data-ic="tt" title="TikTok">TikTok</span><b>@hostilidad</b><small>8,1 k</small></li><li><span class="ic" data-ic="sp" title="Spotify">Spotify</span><b>Hostilidad</b><small>3.240 oyentes/mes</small></li><li><span class="ic" data-ic="yt" title="YouTube">YouTube</span><b>Hostilidad</b><small>2,1 k</small></li></ul><div class="rc__btns"><a class="rc__go" href="#">Seguir</a><a class="rc__ln" href="#">Contactar</a></div></div></article><article class="rc"><div class="rc__img" style="background-image:url(/covers/video.jpg)"></div><span class="rc__role">Producción</span><div class="rc__bot"><b>Marcos R.</b><div class="rc__tags"><span>Bajo</span><span>Sintes</span><span>Arreglos</span></div><div class="rc__sig"><svg viewBox="0 0 160 56" aria-hidden="true"><path d="M8 30 C20 40 24 10 34 12 C44 14 30 44 46 40 C58 36 62 14 74 16 C84 18 78 40 94 38 C106 36 112 22 124 26 C134 30 138 38 152 20" pathLength="1"/></svg><small>Firmado 12 mar</small></div></div><div class="rc__back"><div class="rc__bh"><b>Marcos R.</b><span>Productor · Valencia</span></div><ul class="rc__list"><li><span class="ic" data-ic="ig" title="Instagram">Instagram</span><b>@marcosr.prod</b><small>5,6 k</small></li><li><span class="ic" data-ic="yt" title="YouTube">YouTube</span><b>Marcos R.</b><small>3,4 k</small></li><li><span class="ic" data-ic="cdr" title="En WavsX">En WavsX</span><b>14 créditos</b><small>6 artistas</small></li><li><span class="ic" data-ic="wx" title="Estilo">Estilo</span><b>Trap · Drill</b><small>140 BPM</small></li></ul><div class="rc__btns"><a class="rc__go" href="#">Seguir</a><a class="rc__ln" href="#">Contactar</a></div></div></article><article class="rc"><div class="rc__img" style="background-image:url(/covers/mesa.jpg)"></div><span class="rc__role">Mezcla y master</span><div class="rc__bot"><b>Estudio Sur</b><div class="rc__tags"><span>Mezcla</span><span>Master</span></div><div class="rc__sig"><svg viewBox="0 0 160 56" aria-hidden="true"><path d="M6 34 L20 12 L32 40 L46 12 L58 40 C70 40 76 20 88 26 C98 31 92 44 106 40 C120 36 130 18 154 22" pathLength="1"/></svg><small>Firmado 12 mar</small></div></div><div class="rc__back"><div class="rc__bh"><b>Estudio Sur</b><span>Estudio · Sevilla</span></div><div class="rc__map" aria-hidden="true"><i></i></div><ul class="rc__list"><li><span class="ic" data-ic="pin" title="Dirección">Dirección</span><b>C/ Feria 42</b><small>Sevilla</small></li><li><span class="ic" data-ic="clk" title="Horario">Horario</span><b>L–V 10:00–22:00</b><small>sáb. con cita</small></li><li><span class="ic" data-ic="ig" title="Instagram">Instagram</span><b>@estudiosur</b><small>9,8 k</small></li></ul><div class="rc__btns"><a class="rc__go" href="#">Contactar</a><a class="rc__ln" href="#">Seguir</a></div></div></article></div>
        </div>
        <div class="pane" data-i="5">
          <div class="pane__top"><b>Historial</b><span class="badge">carpeta de versiones</span></div>
          <div class="vx">
            <div class="vx__top">
              <div class="vx__txt">
                <small>¿Y las versiones?</small>
                <h3>Cada versión, guardada para siempre.</h3>
                <p>De la demo del móvil al master: todo vive en la carpeta de la canción. Ábrela o elige una versión y vuelve a ella cuando quieras.</p>
                <div class="vx__song"><i style="background-image:url(/covers/foto.jpg)"></i><div><b>Resiliencia</b><span>Hostilidad · 9 versiones</span></div></div>
              </div>
              <div class="vx__pick">
                <div class="vsel"><button type="button" class="vsel__btn" aria-haspopup="listbox" aria-expanded="false"><small>Versión</small><span>v9 · master</span><i aria-hidden="true"></i></button><ul class="vsel__list" role="listbox" aria-label="Versiones de Resiliencia"></ul></div>
                <div class="tl__card"><b></b><span></span><small></small></div>
              </div>
            </div>
            <div class="vx__art">
              <canvas class="globe" aria-hidden="true"></canvas>
              <div class="crate" id="crate"><p class="crate__hint">Pulsa la carpeta</p><div class="tl__nodes"></div><button type="button" class="crate__front" aria-expanded="false" aria-label="Abrir la carpeta de versiones"><span class="crate__badge" aria-hidden="true"></span><span class="crate__lbl">Resiliencia</span></button></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="ledline" aria-hidden="true"><span></span></div>

  <!-- 3 · LA VIDA DE UNA CANCIÓN -->
  <section class="story" id="como">
    <div class="story__sticky">
      <div class="story__text">
        <span class="kicker">De la primera idea a la distribuidora</span>
        <h2>La vida de una canción,<br>en un solo sitio.</h2>
        <ol class="steps" id="steps">
          <li class="is-active" data-sticker="subir|Paso 01 · súbelo" style="--sc: var(--c1)"><div><h3>Súbelo todo</h3><p>Arrastra la carpeta y WavsX separa audio, stems, portadas y letras.</p></div></li>
          <li data-sticker="versiones|Paso 02 · versiona" style="--sc: var(--c2)"><div><h3>Versiona sin perder nada</h3><p>Cada mezcla nueva es una versión. Las anteriores siguen ahí.</p></div></li>
          <li data-sticker="escucha|Paso 03 · comparte" style="--sc: var(--c3)"><div><h3>Comparte sin soltar el archivo</h3><p>Un enlace privado para tu productor: escucha y comenta, pero no descarga.</p></div></li>
          <li data-sticker="lanzar|Paso 04 · lánzala" style="--sc: var(--c4)"><div><h3>Lánzala</h3><p>Checklist completo y paquete listo para tu distribuidora.</p></div></li>
        </ol>
      </div>

      <div class="story__stage" id="stage" aria-hidden="true">
        <div class="songcard">
          <div class="songcard__top">
            <div class="songcard__cover"></div>
            <div><b>Resiliencia</b><span class="songcard__status" id="sc-status">Demo · v1</span></div>
            <span class="songcard__badge" id="sc-badge"></span>
          </div>

          <div class="scene is-active" data-scene="0">
            <div class="drop"><span data-icon="subir"></span>Suelta aquí la carpeta de la canción</div>
            <ul class="files">
              <li><span class="ft" data-icon="wav" style="--ic: var(--c1)"></span>mezcla_v1.wav<small class="num">38 MB</small></li>
              <li><span class="ft" data-icon="stems" style="--ic: var(--c2)"></span>stems.zip<small class="num">412 MB</small></li>
              <li><span class="ft" data-icon="portada" style="--ic: var(--c3)"></span>portada.jpg<small class="num">4 MB</small></li>
