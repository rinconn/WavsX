---
import Base from '../layouts/Base.astro';
import '../styles/landing.css';
const keeps = [
  ['wav', 'Audio WAV', '24-bit · 48 kHz'],
  ['stems', 'Stems', '12 pistas'],
  ['portada', 'Portadas', '3000 × 3000'],
  ['letra', 'Letra', 'con sincronía'],
  ['creditos', 'Créditos', '60 / 40'],
  ['versiones', 'Versiones', 'v1 → v9'],
  ['enlace', 'Enlaces privados', 'solo escuchar'],
  ['lanzar', 'Lanzamiento', 'checklist y paquete']
];
---
<Base title="WavsX — Tu música, antes de salir" description="El estudio online para artistas: cada canción con sus WAV, stems, portadas, versiones y lanzamiento, en un solo sitio.">
<header class="nav">
  <a href="/" class="logo" data-logo aria-label="WavsX, inicio">wavsX</a>
  <nav aria-label="Principal" class="nav__links">
    <a href="#producto">Producto</a>
    <a href="#como">Cómo funciona</a>
    <a href="#empezar">Precios</a>
  </nav>
  <a href="/login" class="btn btn--neon nav__cta">Entrar</a>
  <span class="nav__progress" id="read" aria-hidden="true"></span>
</header>

<main>
  <!-- 1 · HERO -->
  <section class="hero">
    <canvas id="field" class="hero__canvas" aria-hidden="true"></canvas>
    <div class="hero__fade" aria-hidden="true"></div>
    <div class="hero__content">
      <h1 class="hero__title">
        <span class="line"><span>Tus canciones,</span></span>
        <span class="line"><span class="title-dim">antes de salir.</span></span>
      </h1>
      <p class="hero__sub" data-words>El estudio online para artistas. Cada tema con sus WAVs, stems, portadas y versiones, en un solo sitio.</p>
      <div class="hero__cta">
        <a href="/login" class="btn btn--neon btn--lg">Entrar en mi estudio</a>
        <a href="#como" class="btn btn--lg btn--ghost">Ver cómo funciona <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <a href="#producto" class="scroll-cue" aria-label="Bajar"><span></span></a>
  </section>

  <!-- 1 · HERO C (opción alternativa: /?hero=c) · cúpula de partículas -->
  <section class="heroC" hidden>
    <div class="heroC__content">
      <h1 class="hero__title">
        <span class="line"><span>Tus canciones,</span></span>
        <span class="line"><span class="title-dim">antes de salir.</span></span>
      </h1>
      <p class="hero__sub">Cada tema con sus WAVs, stems, portadas y versiones, en un solo sitio.</p>
      <div class="hero__cta">
        <a href="/login" class="btn btn--neon btn--lg">Entrar en mi estudio</a>
        <a href="#como" class="btn btn--lg btn--ghost">Ver cómo funciona <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <canvas id="dome" class="heroC__canvas" aria-hidden="true"></canvas>
    <canvas id="wavefield" class="heroC__canvas" aria-hidden="true"></canvas>
  </section>

  <!-- 1 · HERO B (opción alternativa: /?hero=b) -->
  <section class="heroB" hidden>
    <div class="heroB__glow" aria-hidden="true"></div>
    <div class="heroB__head">
      <h1 class="hero__title">
        <span class="line"><span>Tus canciones,</span></span>
        <span class="line"><span class="title-dim">antes de salir.</span></span>
      </h1>
      <p class="hero__sub">Cada tema con sus WAVs, stems, portadas y versiones, en un solo sitio.</p>
      <div class="hero__cta">
        <a href="/login" class="btn btn--neon btn--lg">Entrar en mi estudio</a>
        <a href="#como" class="btn btn--lg btn--ghost">Ver cómo funciona <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="heroB__win" aria-hidden="true">
      <div class="heroB__bar"><i></i><i></i><i></i><span>wavsx.app / neon-en-la-m-30</span></div>
      <div class="heroB__body">
        <div class="heroB__top">
          <div class="songcard__cover"></div>
          <div><b>Neón en la M-30</b><span class="songcard__status">Mezcla · v5 · 3:42</span></div>
          <span class="heroB__pill">Lista para salir</span>
        </div>
        <div class="vers"><span>v1</span><span>v2</span><span>v3</span><span>v4</span><span class="on">v5</span></div>
        <div class="bigwave">
          <span class="pin" style="left: 28%">0:48 · sube la voz</span>
          <div class="wave" id="heroB-wave" style="height: 88px"></div>
          <i class="heroB__head-line"></i>
        </div>
        <div class="heroB__stats">
          <div><small>Audio</small><b class="num">WAV 24-bit</b></div>
          <div><small>Stems</small><b class="num">12 pistas</b></div>
          <div><small>Créditos</small><b class="num">60 / 40</b></div>
          <div><small>Enlace privado</small><b class="num">3 escuchas</b></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CARRUSEL · lo que guarda cada canción -->
  <div class="marquee" aria-label="Lo que guarda cada canción">
    <div class="marquee__track">
      {[0, 1].map((n) => (
        <ul class="marquee__group" aria-hidden={n === 1 ? 'true' : undefined}>
          {keeps.map(([ic, label, tag], i) => (
            <li class="marquee__item"><i class="marquee__n">{String(i + 1).padStart(2, '0')}</i><span class="marquee__ico" data-icon={ic}></span><b>{label}</b><small>{tag}</small></li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  <div class="ledline" aria-hidden="true"><span></span></div>

  <!-- 2 · LO QUE GUARDA CADA CANCIÓN -->
  <section class="keeps" id="producto">
    <header class="keeps__head reveal">
      <span class="kicker">Lo que guarda cada canción</span>
      <h2>Seis cosas que siempre andan perdidas.<br><span class="muted">Ahora, juntas.</span></h2>
    </header>
    <div class="keeps__grid">
      <article class="keep reveal" style="--kc: var(--c1); --kc-rgb: var(--c1-rgb)">
        <span class="keep__ico" data-icon="wav"></span>
        <h3>Audio</h3><p>Todas las mezclas y el master en WAV, sin comprimir.</p>
        <span class="keep__tag">24-bit · 48 kHz</span>
      </article>
      <article class="keep reveal" style="--kc: var(--c2); --kc-rgb: var(--c2-rgb)">
        <span class="keep__ico" data-icon="stems"></span>
        <h3>Stems</h3><p>Las pistas sueltas para remezclar o mandar al ingeniero.</p>
        <span class="keep__tag">12 pistas</span>
      </article>
      <article class="keep reveal" style="--kc: var(--c3); --kc-rgb: var(--c3-rgb)">
        <span class="keep__ico" data-icon="portada"></span>
        <h3>Portadas</h3><p>La final, las alternativas y las fotos de la sesión.</p>
        <span class="keep__tag">3000 × 3000</span>
      </article>
      <article class="keep reveal" style="--kc: var(--c4); --kc-rgb: var(--c4-rgb)">
        <span class="keep__ico" data-icon="letra"></span>
        <h3>Letra</h3><p>La versión buena, no la de las notas del móvil.</p>
        <span class="keep__tag">con sincronía</span>
      </article>
      <article class="keep reveal" style="--kc: var(--c1); --kc-rgb: var(--c1-rgb)">
        <span class="keep__ico" data-icon="creditos"></span>
        <h3>Créditos y reparto</h3><p>Quién hizo qué y cuánto le toca a cada uno.</p>
        <span class="keep__tag">60 / 40</span>
      </article>
      <article class="keep reveal" style="--kc: var(--c2); --kc-rgb: var(--c2-rgb)">
        <span class="keep__ico" data-icon="versiones"></span>
        <h3>Versiones</h3><p>De la demo del móvil al master, sin borrar ninguna.</p>
        <span class="keep__tag">v1 → v9</span>
      </article>
    </div>
  </section>

  <div class="ledline" aria-hidden="true"><span></span></div>

  <!-- 3 · LA VIDA DE UNA CANCIÓN -->
  <section class="story" id="como">
    <div class="story__sticky">
      <div class="story__text">
        <span class="kicker">De la primera idea a la distribuidora</span>
        <h2>La vida de una canción,<br>en un solo sitio.</h2>
        <ol class="steps" id="steps">
          <li class="is-active" data-sticker="subir|Paso 01 · súbelo" style="--sc: var(--c1)"><div><h3>Súbelo todo</h3><p>Arrastra la carpeta y WavsX separa audio, stems, portadas y letras.</p></div></li>
          <li data-sticker="versiones|Paso 02 · versiona" style="--sc: var(--c2)"><div><h3>Versiona sin perder nada</h3><p>Cada mezcla nueva es una versión. Las anteriores siguen ahí.</p></div></li>
          <li data-sticker="escucha|Paso 03 · comparte" style="--sc: var(--c3)"><div><h3>Comparte sin soltar el archivo</h3><p>Un enlace privado para tu productor: escucha y comenta, pero no descarga.</p></div></li>
          <li data-sticker="lanzar|Paso 04 · lánzala" style="--sc: var(--c4)"><div><h3>Lánzala</h3><p>Checklist completo y paquete listo para tu distribuidora.</p></div></li>
        </ol>
      </div>

      <div class="story__stage" id="stage" aria-hidden="true">
        <div class="songcard">
          <div class="songcard__top">
            <div class="songcard__cover"></div>
            <div><b>Neón en la M-30</b><span class="songcard__status" id="sc-status">Demo · v1</span></div>
            <span class="songcard__badge" id="sc-badge"></span>
          </div>

          <div class="scene is-active" data-scene="0">
            <div class="drop"><span data-icon="subir"></span>Suelta aquí la carpeta de la canción</div>
            <ul class="files">
              <li><span class="ft" data-icon="wav" style="--ic: var(--c1)"></span>mezcla_v1.wav<small class="num">38 MB</small></li>
              <li><span class="ft" data-icon="stems" style="--ic: var(--c2)"></span>stems.zip<small class="num">412 MB</small></li>
              <li><span class="ft" data-icon="portada" style="--ic: var(--c3)"></span>portada.jpg<small class="num">4 MB</small></li>
              <li><span class="ft" data-icon="letra" style="--ic: var(--c4)"></span>letra.txt<small class="num">2 KB</small></li>
            </ul>
          </div>

          <div class="scene" data-scene="1">
            <div class="vers"><span>v1</span><span>v2</span><span>v3</span><span>v4</span><span class="on">v5</span></div>
            <div class="bigwave">
              <span class="pin" style="left: 28%">0:48 · sube la voz</span>
              <div class="wave wave--grad" id="story-wave" style="height: 96px"></div>
            </div>
            <p class="note"><b>Productor</b> comentó en el 0:48</p>
          </div>

          <div class="scene" data-scene="2">
            <div class="share">
              <span class="share__label"><span data-icon="enlace"></span>Enlace privado · v5</span>
              <code>wavsx.app/s/k4ir0-n30n</code>
              <div class="share__row"><span>Permitir descarga</span><i class="sw"></i></div>
            </div>
            <ul class="activity">
              <li><span class="av" style="--ic: var(--c3)">P</span><div><b>Productor</b> lo ha escuchado 3 veces</div><small>hace 2 min</small></li>
              <li><span class="av" style="--ic: var(--c2)">S</span><div><b>Sello</b> ha abierto el enlace</div><small>hace 1 h</small></li>
            </ul>
          </div>

          <div class="scene" data-scene="3">
            <ul class="checks">
              <li><i></i>Portada 3000 × 3000</li>
              <li><i></i>Créditos y reparto</li>
              <li><i></i>Master final en WAV</li>
              <li><i></i>ISRC y fecha de salida</li>
            </ul>
            <div class="ready"><span data-icon="lanzar"></span>Lista para salir · 28 nov</div>
          </div>
        </div>
        <div class="dots" id="dots"><i class="on"></i><i></i><i></i><i></i></div>
      </div>
    </div>
  </section>

  <div class="ledline" aria-hidden="true"><span></span></div>

  <!-- 4 · ON AIR -->
  <section class="onair" id="empezar">
    <div class="onair__glow" aria-hidden="true"></div>
    <div class="sign" id="sign" aria-hidden="true"><span class="sign__dot"></span>ON AIR</div>
    <h2 class="reveal">Tu estudio<br><span class="grad-text">está abierto.</span></h2>
    <p class="reveal">Gratis hasta 10 canciones. Sin tarjeta.</p>
    <div class="onair__cta reveal">
      <a href="/login" class="btn btn--neon btn--lg">Crear cuenta gratis</a>
      <a href="/login" class="btn btn--lg">Ya tengo cuenta</a>
    </div>
  </section>
</main>

<footer class="footer">
  <span class="logo" data-logo style="font-size: 16px">wavsX</span>
  <span class="muted">Hecho para artistas que todavía no han sacado su mejor tema.</span>
</footer>
<script>import '../scripts/landing.js';</script>
</Base>
